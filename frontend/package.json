{
  "name": "aquiles-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests vite.config.js --max-warnings 0",
    "lint:fix": "eslint src tests vite.config.js --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json}\""
  },
  "dependencies": {
    "axios": "^1.14.0",
    "d3": "^7.9.0",
    "vue": "^3.5.24",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "vite": "^7.2.4"
  }
}
