# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Aquiles runtime =====
SECRET_KEY=replace_with_a_long_random_value
FLASK_DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COLLECTION_SCHEDULER_SERVICE_HOST=127.0.0.1
COLLECTION_SCHEDULER_SERVICE_PORT=5023
COLLECTION_SCHEDULER_SERVICE_URL=http://127.0.0.1:5023
COLLECTION_SCHEDULER_REQUEST_TIMEOUT_SECONDS=60
OPTIONS_VOLUME_TRACKER_SERVICE_URL=http://127.0.0.1:5015
OPTIONS_VOLUME_TRACKER_REQUEST_TIMEOUT_SECONDS=120

# ===== Persistence =====
# filesystem preserves single-host compatibility; use postgresql for shared writes.
AQUILES_PERSISTENCE_BACKEND=filesystem
DATABASE_URL=
# Redis is reserved for queues, cache and distributed locks.
REDIS_URL=
AQUILES_RAW_STORAGE_ROOT=backend/uploads

# ===== Authentication and authorization =====
AQUILES_AUTH_ENABLED=True
AQUILES_AUTH_TOKEN_SECRET=replace_with_a_distinct_long_random_value
AQUILES_INTERNAL_SERVICE_TOKEN=replace_with_another_long_random_value
# Generate password hashes with scripts/create_auth_user.py; never store plaintext passwords here.
AQUILES_AUTH_USERS_JSON={"admin":{"password_hash":"replace_with_generated_hash","roles":["admin"],"active":true}}
AQUILES_AUTH_TOKEN_TTL_SECONDS=28800
AQUILES_AUTH_LOGIN_MAX_ATTEMPTS=5
AQUILES_AUTH_LOGIN_WINDOW_SECONDS=300

# ===== Graph backend =====
GRAPH_BACKEND=zep_cloud

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Graphiti local (optional) =====
GRAPHITI_DATABASE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ===== CVM CDA deterministic graph microservice =====
CVM_CDA_GRAPH_SERVICE_HOST=0.0.0.0
CVM_CDA_GRAPH_SERVICE_PORT=5017
CVM_CDA_GRAPH_GROUP_ID=funds_flow_local:cvm_cda
CVM_CDA_GRAPH_MAX_FUNDS=350
CVM_CDA_GRAPH_MAX_POSITIONS_PER_FUND=30
CVM_CDA_GRAPH_MIN_ABS_VALUE=10000000
CVM_CDA_GRAPH_TARGET_FUNDS_PER_THEME=60

# ===== 加速 LLM 配置（可选）=====
